#!/usr/bin/env sh
# Block pushes that don't test or build cleanly. Runs `pnpm vitest run`
# then `pnpm build`, followed by the dist-level checks.
# Catches frontmatter loss, broken image refs that Astro validates,
# schema drift, and stray TS errors in pages/components.
#
# Bypass with `git push --no-verify` if you absolutely must.

set -e

# Run from the repo root no matter where the hook fires from.
cd "$(git rev-parse --show-toplevel)"

# Quietly fall back if pnpm is missing (e.g., obsidian-git on Android, which
# can't run shell hooks at all and won't reach this branch).
if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm not found; skipping pre-push build check" >&2
  exit 0
fi

# Run the unit suite first — it is the fastest gate (~6s) and the one most
# likely to catch a logic regression, so failing here saves a build.
echo "pre-push: running vitest..." >&2
if ! pnpm -s vitest run >/tmp/blogs-prepush.log 2>&1; then
  echo "" >&2
  echo "pre-push: tests FAILED. Push aborted." >&2
  tail -40 /tmp/blogs-prepush.log >&2
  echo "" >&2
  echo "Full log: /tmp/blogs-prepush.log" >&2
  echo "Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: tests ok" >&2

echo "pre-push: running pnpm build..." >&2
if ! pnpm build >>/tmp/blogs-prepush.log 2>&1; then
  echo "" >&2
  echo "pre-push: build FAILED. Push aborted." >&2
  echo "Last 30 lines of build output:" >&2
  tail -30 /tmp/blogs-prepush.log >&2
  echo "" >&2
  echo "Full log: /tmp/blogs-prepush.log" >&2
  echo "Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi

echo "pre-push: build ok" >&2

# Smoke check: build success != output correct. A broken content loader
# (e.g., one that stores raw markdown but skips renderMarkdown) emits
# pages with an empty <article> body and ~3KB total HTML. If even the
# largest post in dist is suspiciously small, fail the push.
SMOKE_THRESHOLD=20000
LARGEST=$(find dist/posts -name 'index.html' \
  -not -path 'dist/posts/index.html' \
  -exec wc -c {} \; 2>/dev/null \
  | awk '{print $1}' | sort -n | tail -1)
if [ -z "$LARGEST" ] || [ "$LARGEST" -lt "$SMOKE_THRESHOLD" ]; then
  echo "" >&2
  echo "pre-push: post-output smoke check FAILED." >&2
  echo "  Largest dist/posts/<slug>/index.html: ${LARGEST:-0} bytes" >&2
  echo "  Expected at least ${SMOKE_THRESHOLD} bytes." >&2
  echo "  Likely a content-loader regression: pages built but bodies are empty." >&2
  echo "  Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: smoke check ok (largest post = $LARGEST bytes)" >&2

# Lint markdown for `../` image escapes — those resolve at the URL layer
# (`/posts/<slug>/`) and silently 404 once the post is served.
if ! pnpm -s check:content-paths >>/tmp/blogs-prepush.log 2>&1; then
  echo "" >&2
  echo "pre-push: content image-path lint FAILED. Push aborted." >&2
  tail -30 /tmp/blogs-prepush.log >&2
  echo "Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: content image-paths ok" >&2

# Walk dist HTML for dead <img>/<script>/<link>/<a> targets. Catches the
# class of bug where a build "succeeds" but emits references to files that
# don't exist under dist/.
if ! pnpm -s check:assets >>/tmp/blogs-prepush.log 2>&1; then
  echo "" >&2
  echo "pre-push: dead-asset check FAILED. Push aborted." >&2
  tail -40 /tmp/blogs-prepush.log >&2
  echo "Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: dead-asset check ok" >&2

# Verify dist/thoughts/rss.xml carries exactly one stable, non-permalink
# <guid> per item. Guards against @astrojs/rss silently reverting to
# link-derived permalink guids (which would re-mark every thought as unread
# for every subscriber) — see scripts/check-thoughts-guid.ts for why this
# can't be caught by check:assets or a type error.
if ! pnpm -s check:thoughts-guid >>/tmp/blogs-prepush.log 2>&1; then
  echo "" >&2
  echo "pre-push: thoughts feed guid check FAILED. Push aborted." >&2
  tail -40 /tmp/blogs-prepush.log >&2
  echo "Bypass (use sparingly): git push --no-verify" >&2
  exit 1
fi
echo "pre-push: thoughts feed guid check ok" >&2
