    <script is:inline>
      const show = (id) => {
        document.querySelectorAll('.screen').forEach((s) => s.classList.toggle('on', s.id === id));
      };
      const pane = (name) => {
        document.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.pane === name)));
        document.getElementById('p-write').classList.toggle('on', name === 'write');
        document.getElementById('p-preview').classList.toggle('on', name === 'preview');
      };
      document.querySelectorAll('.tab').forEach((t) => t.addEventListener('click', () => pane(t.dataset.pane)));
      document.querySelectorAll('#mockbar button[data-go]').forEach((b) => {
        b.addEventListener('click', () => {
          document.querySelectorAll('#mockbar button[data-go]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          const go = b.dataset.go;
          if (go === 'list') show('s-list');
          else if (go === 'editor') { show('s-editor'); pane('write'); }
          else if (go === 'preview') { show('s-editor'); pane('preview'); }
          else document.getElementById('settings').showModal();
        });
      });
      document.getElementById('s-close').addEventListener('click', () => document.getElementById('settings').close());
      document.querySelector('.newpost').addEventListener('click', () => { show('s-editor'); pane('write'); });
      document.querySelectorAll('#s-list .row').forEach((r) => r.addEventListener('click', () => { show('s-editor'); pane('write'); }));
      document.querySelector('#s-editor .icon-btn').addEventListener('click', () => show('s-list'));
      document.getElementById('theme').addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        document.documentElement.setAttribute('data-theme', cur === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
